# =============================================================================
# KidsLearn — environment
#
# Copy to .env and adjust. Never commit a real .env.
# Anything the browser may read MUST be prefixed NEXT_PUBLIC_; everything else
# stays server-side only.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
# IANA timezone used for streaks, day buckets and scheduled jobs.
APP_TIMEZONE=Asia/Tashkent

# --- Database ----------------------------------------------------------------
POSTGRES_USER=kidslearn
POSTGRES_PASSWORD=kidslearn_dev
POSTGRES_DB=kidslearn
POSTGRES_PORT=55432
DATABASE_URL=postgresql://kidslearn:kidslearn_dev@localhost:55432/kidslearn?schema=public

# --- Redis (cache + BullMQ) ---------------------------------------------------
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

# --- Auth ---------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Cookie domain for the refresh token; leave blank for localhost.
COOKIE_DOMAIN=
# Set to true behind HTTPS in production.
COOKIE_SECURE=false

# --- Object storage (S3-compatible; MinIO locally) ----------------------------
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=kidslearn
S3_SECRET_KEY=kidslearn_dev_secret
S3_BUCKET=kidslearn
# Public base URL used to build asset links (CDN in production).
S3_PUBLIC_URL=http://localhost:59000/kidslearn
S3_FORCE_PATH_STYLE=true

# --- AI providers -------------------------------------------------------------
# Leave AI_IMAGE_PROVIDER unset (or "preview") to keep the honest preview mode:
# no image model is called and the UI says so.
# Supported: preview | openai
AI_IMAGE_PROVIDER=preview
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-1
# Supported: rule-based | anthropic | openai
AI_RECOMMENDATION_PROVIDER=rule-based
AI_RECOMMENDATION_API_KEY=
AI_RECOMMENDATION_MODEL=claude-opus-5

# --- Web push -----------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
# Leave blank to have the API report push as "configuration required".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:help@kidslearn.app

# --- Rate limiting ------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=debug

# --- Web app ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

{
  "name": "kidslearn",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @kidslearn/web dev",
    "dev:api": "pnpm --filter @kidslearn/api dev",
    "build": "pnpm --filter @kidslearn/database build && pnpm --filter @kidslearn/types build && pnpm --filter @kidslearn/api build && pnpm --filter @kidslearn/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @kidslearn/api test",
    "test:e2e": "pnpm --filter @kidslearn/web test:e2e",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema prisma/schema.prisma --force",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "test:integration": "pnpm --filter @kidslearn/api test:integration"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  }
}
